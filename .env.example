DATA_DIR=./data
ENGINE_BIN=climate_sim
MPIRUN=mpirun
MPIRUN_ARGS=--oversubscribe
CORS_ORIGINS=http://localhost:3000
ENGINE_PERIODIC=1
DISK_SAFETY_MARGIN_BYTES=2147483648
ENGINE_MEMORY_RESERVE_BYTES=536870912
# ENGINE_MEMORY_BYTES=
PREVIEW_MEMORY_BYTES=268435456
NATIVE_IMAGE_RAM_FRACTION=0.25
# CPU priority (nice 0..19) for the engine so the API stays responsive; 0 disables
ENGINE_NICE=10
